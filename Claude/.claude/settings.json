{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/bradly/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "zsh '/Users/bradly/.claude/statusline-command.sh'"
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell"
}
