{
    //----------------------------Editor Settings---------------------------------
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": false
    },
    "tabs": {
        "file_icons": false,
        "git_status": false
    },
    "terminal": {
        "dock": "bottom"
    },
    "ssh_connections": [
        {
            "host": "warpserver",
            "username": "brad",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/home/brad"
                    ]
                },
                {
                    "paths": [
                        "/home/brad/code/lumix"
                    ]
                }
            ]
        }
    ],
    "language_models": {
        "opencode": {
            "show_go_models": false
        }
    },
    "collaboration_panel": {
        "button": false,
        "dock": "right"
    },
    "debugger": {
        "dock": "left"
    },
    "vim": {
        "use_system_clipboard": "always"
    },
    "agent": {
        "dock": "left",
        "thinking_display": "always_collapsed",
        "favorite_models": [],
        "play_sound_when_agent_done": "when_hidden",
        "model_parameters": []
    },
    "agent_servers": {
        "claude-acp": {
            "default_config_options": {
                "fast": false,
                "model": "opus",
                "effort": "medium",
                "mode": "plan"
            },
            "type": "registry"
        },
        "opencode": {
            "default_config_options": {
                "model": "opencode/deepseek-v4-pro",
                "mode": "build"
            },
            "type": "registry"
        }
    },
    "show_edit_predictions": false,
    "restore_on_startup": "launchpad",
    "tab_size": 2,
    "disable_ai": true,
    "cli_default_open_behavior": "existing_window",
    "diff_view_style": "unified",
    "diagnostics": {
        "include_warnings": true,
        "inline": {
            "enabled": true
        }
    },
    "buffer_font_size": 18.0,
    "git_panel": {
        "dock": "right",
    },
    "vim_mode": false,
    "format_on_save": "off",
    "session": {
        "restore_unsaved_buffers": false,
        "trust_all_worktrees": true
    },
    //-----------------------------------UI---------------------------------------
    "outline_panel": {
        "dock": "left",
        "auto_reveal_entries": true,
        "button": true,
        "indent_guides": {
            "show": "always"
        },
        "auto_fold_dirs": true,
        "indent_size": 20.0,
        "file_icons": true,
        "expand_outlines_with_depth": 0
    },
    "scrollbar": {
        "axes": {
            "horizontal": false,
            "vertical": false
        },
        "show": "auto"
    },
    "gutter": {
        "folds": false,
        "breakpoints": false,
        "runnables": false,
        "min_line_number_digits": 0
    },
    "project_panel": {
        "folder_indicator": "icon",
        "auto_reveal_entries": false,
        "file_icons": true,
        "hide_gitignore": false,
        "dock": "right"
    },
    "colorize_brackets": true,
    "wrap_guides": [80],
    "ui_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_weight": 300.0,
    "buffer_line_height": "standard",
    "buffer_font_features": {
        "liga": true
    },
    //--------------------------------Theming-------------------------------------
    "theme": {
        "mode": "system",
        "light": "Zedokai Light",
        "dark": "Zedokai (Filter Spectrum)"
    },
    "icon_theme": {
        "mode": "system",
        "light": "Colored Zed Icons Theme Light",
        "dark": "Colored Zed Icons Theme Dark"
    },
    //--------------------------------Language------------------------------------
}
